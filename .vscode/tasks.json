{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sniper: iniciar app",
      "type": "shell",
      "command": ".\\iniciar.bat",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Sniper: preparar ambiente",
      "type": "shell",
      "command": "if (!(Test-Path .venv)) { python -m venv .venv; .\\.venv\\Scripts\\python -m pip install -r requirements.txt }; if (!(Test-Path config.toml)) { Copy-Item config.exemplo.toml config.toml }; if (!(Test-Path data)) { New-Item -ItemType Directory data | Out-Null }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Sniper: rodar testes",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python -m unittest discover tests -v",
      "group": "test",
      "problemMatcher": []
    }
  ]
}