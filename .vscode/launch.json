{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sniper: abrir app (janela)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Sniper: preparar ambiente",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    {
      "name": "Sniper: abrir no navegador",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": [
        "--navegador"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Sniper: preparar ambiente",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    {
      "name": "Sniper: autorizar Mercado Livre",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/auth_ml.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "preLaunchTask": "Sniper: preparar ambiente"
    }
  ]
}